# Postgres connection string used by Prisma Client + Prisma Migrate
DATABASE_URL="postgresql://app_user:app_password@localhost:5432/event_registration?schema=public"

# Reservation expiry window, in minutes (Reserved -> Expired if not Confirmed in time)
RESERVATION_EXPIRY_MINUTES=15

# NextAuth / Lucia session secret (generate with `openssl rand -base64 32`)
AUTH_SECRET=""

# Base URL NextAuth uses for callbacks; your deployed URL in production
AUTH_URL="http://localhost:3000"

# Max rows scanned per invocation of the stale-reservation expiry cron job
EXPIRE_BATCH_SIZE=200
